<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BlindfoldChess" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/loader</item>
        <item name="postSplashScreenTheme">@style/Theme.BlindfoldChess</item>
    </style>
    <style name="Theme.BlindfoldChess2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main background color -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/card_dark</item>

        <!-- Primary Green Palette for Buttons and Accents -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/green_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
</resources>