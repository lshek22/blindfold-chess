<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtGameMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Side: White | Mode: Kings &amp; Pawns"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtGameDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtGameMeta"
            android:layout_marginTop="4dp"
            android:text="Date: 2026-06-13"
            android:textColor="#777777"
            android:textSize="13sp" />

        <!-- Trash Icon Button to Delete Game -->
        <ImageButton
            android:id="@+id/btnDeleteGame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>