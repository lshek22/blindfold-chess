<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/gameSetupFragment">

    <fragment
        android:id="@+id/gameSetupFragment"
        android:name="com.example.blindfoldchess.ui.play.GameSetupFragment"
        android:label="Game Options">
        <action
            android:id="@+id/action_gameSetupFragment_to_playFragment"
            app:destination="@id/playFragment" />
    </fragment>

    <fragment
        android:id="@+id/playFragment"
        android:name="com.example.blindfoldchess.ui.play.PlayFragment"
        android:label="Play">
        <argument
            android:name="selectedSide"
            app:argType="string"
            android:defaultValue="white" />
        <argument
            android:name="pieceStyle"
            app:argType="string"
            android:defaultValue="normal" />
        <argument
            android:name="gameVariant"
            app:argType="string"
            android:defaultValue="standard" />
    </fragment>

    <fragment
        android:id="@+id/trainerFragment"
        android:name="com.example.blindfoldchess.ui.trainer.TrainerFragment"
        android:label="Train">
        <action
            android:id="@+id/action_trainer_to_question_count"
            app:destination="@id/questionCountFragment" />

        <action
            android:id="@+id/action_trainer_to_tacticsFragment"
            app:destination="@id/tacticsFragment" />

        <action
            android:id="@+id/action_trainer_to_coordinateFragment"
            app:destination="@id/coordinateFragment" />

        <action
            android:id="@+id/action_trainer_to_squareColorFragment"
            app:destination="@id/squareColorFragment" />

        <action
            android:id="@+id/action_trainer_to_sameColorFragment"
            app:destination="@id/sameColorFragment" />

        <action
            android:id="@+id/action_trainer_to_sisterSquareFragment"
            app:destination="@id/sisterSquareFragment" />

        <action
            android:id="@+id/action_trainer_to_sameDiagonalFragment"
            app:destination="@id/sameDiagonalFragment" />

        <action
            android:id="@+id/action_trainer_to_knightMovesFragment"
            app:destination="@id/knightMovesFragment" />

        <action
            android:id="@+id/action_trainer_to_moveCountFragment"
            app:destination="@id/moveCountFragment" />
    </fragment>

    <fragment
        android:id="@+id/questionCountFragment"
        android:name="com.example.blindfoldchess.ui.trainer.QuestionCountFragment"
        android:label="How many questions?">
        <action
            android:id="@+id/action_question_count_to_move_count"
            app:destination="@id/moveCountFragment" />
    </fragment>

    <fragment
        android:id="@+id/coordinateFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.CoordinateFragment"
        android:label="Coordinates" />

    <fragment
        android:id="@+id/squareColorFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.SquareColorFragment"
        android:label="Square Color" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.blindfoldchess.ui.history.HistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.blindfoldchess.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/sameColorFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.SameColorFragment"
        android:label="Same Color" />

    <fragment
        android:id="@+id/sisterSquareFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.SisterSquareFragment"
        android:label="Sister Square" />

    <fragment
        android:id="@+id/sameDiagonalFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.SameDiagonalFragment"
        android:label="Same Diagonal" />

    <fragment
        android:id="@+id/moveCountFragment"
        android:name="com.example.blindfoldchess.ui.trainer.MoveCountFragment"
        android:label="Move Count" />

    <fragment
        android:id="@+id/knightMovesFragment"
        android:name="com.example.blindfoldchess.ui.trainer.exercises.KnightMovesFragment"
        android:label="Knight Moves" />

    <fragment
        android:id="@+id/tacticsFragment"
        android:name="com.example.blindfoldchess.ui.trainer.TacticsFragment"
        android:label="Tactics Puzzles" />

</navigation>